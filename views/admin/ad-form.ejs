<%- include('partials/header') %>

<div class="page-top">
  <div>
    <span class="kicker">// PROMOTION</span>
    <h1><%= ad ? 'EDIT AD' : 'NEW AD' %></h1>
  </div>
  <a href="/admin/ads" class="btn btn-ghost">← BACK</a>
</div>

<div class="form-layout">
  <form method="POST" class="admin-form"
        action="<%= ad ? '/admin/ads/' + ad.id : '/admin/ads' %>">
    <div class="f-field">
      <label for="title">Title *</label>
      <input id="title" name="title" required value="<%= ad ? ad.title : '' %>" placeholder="SUMMER DROP '26" />
    </div>

    <div class="f-field">
      <label for="subtitle">Subtitle (optional)</label>
      <input id="subtitle" name="subtitle" value="<%= ad ? ad.subtitle : '' %>" placeholder="Heavyweight tees, now live" />
    </div>

    <div class="f-row">
      <div class="f-field">
        <label for="placement">Placement</label>
        <select id="placement" name="placement">
          <option value="hero" <%= ad && ad.placement === 'hero' ? 'selected' : '' %>>Hero (homepage main)</option>
          <option value="banner" <%= ad && ad.placement === 'banner' ? 'selected' : '' %>>Banner strip</option>
        </select>
      </div>
      <div class="f-field">
        <label for="order">Order (0 = first)</label>
        <input id="order" name="order" type="number" value="<%= ad ? ad.order : 0 %>" />
      </div>
    </div>

    <div class="f-field">
      <label for="link">Link to product (paste product ID) or full URL</label>
      <input id="link" name="link" value="<%= ad ? ad.link : '' %>" placeholder="Optional — leave blank to link to shop" />
    </div>

    <div class="f-field">
      <label>
        <input type="checkbox" name="active" <%= !ad || ad.active ? 'checked' : '' %> />
        <span class="inline-lbl">Active (shown on site)</span>
      </label>
    </div>

    <div class="f-field">
      <label>Ad Image / Video</label>
      <input type="hidden" id="mediaUrl" name="mediaUrl" value="<%= ad ? ad.image : '' %>" />

      <div id="media-preview" style="margin-bottom:12px">
        <% if (ad && ad.image) { %>
          <% if (/\.(mp4|webm|ogg)$/i.test(ad.image)) { %>
            <video src="<%= ad.image %>" controls style="max-width:300px;border-radius:10px;border:1px solid var(--line)"></video>
          <% } else { %>
            <img src="<%= ad.image %>" style="max-width:300px;border-radius:10px;border:1px solid var(--line)" />
          <% } %>
        <% } %>
      </div>

      <label for="fileUpload" class="btn btn-primary" style="cursor:pointer;display:inline-block;margin-bottom:8px">UPLOAD IMAGE / VIDEO</label>
      <input type="file" id="fileUpload" accept="image/*,video/mp4,video/webm" style="display:none" />

      <div id="uploadStatus" style="font-family:var(--mono);font-size:12px;color:var(--muted);margin-top:6px;display:none"></div>
    </div>

    <div class="f-field">
      <label for="imageUrl">Or paste an image URL</label>
      <input id="imageUrl" name="imageUrl" value="" placeholder="https://example.com/photo.jpg" />
      <div style="margin-top:8px">
        <button type="button" id="useUrlBtn" class="btn btn-ghost" style="font-size:12px">USE THIS URL →</button>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-lg">SAVE AD →</button>
      <a href="/admin/ads" class="btn btn-ghost">CANCEL</a>
    </div>
  </form>
</div>

<script>
  var fileInput = document.getElementById('fileUpload');
  var mediaUrl = document.getElementById('mediaUrl');
  var preview = document.getElementById('media-preview');
  var status = document.getElementById('uploadStatus');

  fileInput.addEventListener('change', function() {
    if (!fileInput.files || !fileInput.files[0]) return;
    var fd = new FormData();
    fd.append('file', fileInput.files[0]);
    status.style.display = 'block';
    status.style.color = 'var(--muted)';
    status.textContent = 'Uploading to Cloudinary...';
    fetch('/admin/upload', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.error) { status.style.color = 'red'; status.textContent = 'Error: ' + d.error; return; }
        mediaUrl.value = d.url;
        var isVideo = /\.(mp4|webm|ogg)$/i.test(d.url);
        if (isVideo) {
          preview.innerHTML = '<video src="' + d.url + '" controls style="max-width:300px;border-radius:10px;border:1px solid var(--line)"></video>';
        } else {
          preview.innerHTML = '<img src="' + d.url + '" style="max-width:300px;border-radius:10px;border:1px solid var(--line)" />';
        }
        status.style.color = '#7ee08a';
        status.textContent = 'Uploaded!';
      })
      .catch(function(e) { status.style.color = 'red'; status.textContent = 'Upload failed: ' + e.message; });
  });

  document.getElementById('useUrlBtn').addEventListener('click', function() {
    var url = document.getElementById('imageUrl').value.trim();
    if (!url) return alert('Paste a URL first');
    mediaUrl.value = url;
    var isVideo = /\.(mp4|webm|ogg)$/i.test(url);
    if (isVideo) {
      preview.innerHTML = '<video src="' + url + '" controls style="max-width:300px;border-radius:10px;border:1px solid var(--line)"></video>';
    } else {
      preview.innerHTML = '<img src="' + url + '" style="max-width:300px;border-radius:10px;border:1px solid var(--line)" />';
    }
  });
</script>

<%- include('partials/footer') %>
