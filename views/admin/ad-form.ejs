<%- include('partials/header') %>

<div class="page-top">
  <div>
    <span class="kicker">// PROMOTION</span>
    <h1><%= ad ? 'EDIT AD' : 'NEW AD' %></h1>
  </div>
  <a href="/admin/ads" class="btn btn-ghost">← BACK</a>
</div>

<div class="form-layout">
  <form method="POST" enctype="multipart/form-data" class="admin-form"
        action="<%= ad ? '/admin/ads/' + ad.id : '/admin/ads' %>">
    <div class="f-field">
      <label for="title">Title *</label>
      <input id="title" name="title" required value="<%= ad ? ad.title : '' %>" placeholder="SUMMER DROP '26" />
    </div>

    <div class="f-field">
      <label for="subtitle">Subtitle (optional)</label>
      <input id="subtitle" name="subtitle" value="<%= ad ? ad.subtitle : '' %>" placeholder="Heavyweight tees, now live" />
    </div>

    <div class="f-row">
      <div class="f-field">
        <label for="placement">Placement</label>
        <select id="placement" name="placement">
          <option value="hero" <%= ad && ad.placement === 'hero' ? 'selected' : '' %>>Hero (homepage main)</option>
          <option value="banner" <%= ad && ad.placement === 'banner' ? 'selected' : '' %>>Banner strip</option>
        </select>
      </div>
      <div class="f-field">
        <label for="order">Order (0 = first)</label>
        <input id="order" name="order" type="number" value="<%= ad ? ad.order : 0 %>" />
      </div>
    </div>

    <div class="f-field">
      <label for="link">Link to product (paste product ID) or full URL</label>
      <input id="link" name="link" value="<%= ad ? ad.link : '' %>" placeholder="Optional — leave blank to link to shop" />
    </div>

    <div class="f-field">
      <label>
        <input type="checkbox" name="active" <%= !ad || ad.active ? 'checked' : '' %> />
        <span class="inline-lbl">Active (shown on site)</span>
      </label>
    </div>

    <div class="f-field">
      <label for="imageUrl">Image URL (paste a link to an image)</label>
      <input id="imageUrl" name="imageUrl" value="<%= ad ? ad.image : '' %>" placeholder="https://example.com/photo.jpg" />
      <% if (ad && ad.image) { %>
        <div style="margin-top:10px">
          <img src="<%= ad.image %>" style="max-width:200px;border-radius:10px;border:1px solid var(--line)" />
        </div>
      <% } %>
    </div>

    <div class="f-field">
      <label>Or upload from computer</label>
      <input type="file" name="image" id="image" accept="image/*" style="padding:12px;border:1px dashed var(--line);border-radius:10px;background:var(--bg2);width:100%;color:var(--ink);font-family:var(--mono);font-size:13px;" />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-lg">SAVE AD →</button>
      <a href="/admin/ads" class="btn btn-ghost">CANCEL</a>
    </div>
  </form>
</div>

<script>
  const fileInput = document.getElementById('image');
  const preview = document.getElementById('preview');
  fileInput.addEventListener('change', (e) => {
    if (e.target.files && e.target.files[0]) {
      const url = URL.createObjectURL(e.target.files[0]);
      preview.src = url;
      preview.classList.add('img-on');
    }
  });
</script>

<%- include('partials/footer') %>