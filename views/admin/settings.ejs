<%- include('partials/header', { active: 'settings' }) %>
<%
  const s = settings || {};
  const sf = (s.footer) ? s.footer : {};
%>

<div class="page-top">
  <div>
    <span class="kicker">// CONFIG</span>
    <h1>STORE SETTINGS</h1>
  </div>
</div>

<div class="form-layout">
  <form method="POST" action="/admin/settings" class="admin-form">

    <div class="f-field">
      <label>Marquee Text</label>
      <input name="marquee" value="<%= s.marquee || '' %>" placeholder="STREETWEAR • //LIMITED DROPS • AURE • 2026" />
    </div>

    <h2 style="font-size:1rem;margin-top:24px;color:var(--lime);font-family:var(--mono);letter-spacing:2px">// FOOTER</h2>

    <div class="f-field">
      <label for="brandTagline">Brand Tagline</label>
      <input id="brandTagline" name="brandTagline" value="<%= sf.brandTagline || '' %>" />
    </div>

    <div class="f-row">
      <div class="f-field">
        <label for="email">Contact Email</label>
        <input id="email" name="email" type="email" value="<%= sf.email || '' %>" />
      </div>
      <div class="f-field">
        <label for="country">Country</label>
        <input id="country" name="country" value="<%= sf.country || '' %>" />
      </div>
    </div>

    <div class="f-row">
      <div class="f-field">
        <label for="currency">Currency</label>
        <input id="currency" name="currency" value="<%= sf.currency || '' %>" />
      </div>
      <div class="f-field">
        <label for="copyright">Copyright Text</label>
        <input id="copyright" name="copyright" value="<%= sf.copyright || '' %>" />
      </div>
    </div>

    <div class="f-field">
      <label>Shop Links (one per line: label | url)</label>
      <textarea name="shopLinksRaw" rows="5"><% (sf.shopLinks || []).forEach(function(l) { %><%= l.label %> | <%= l.url %>
<% }) %></textarea>
      <div style="font-family:var(--mono);font-size:0.65rem;color:var(--ink3);margin-top:4px">Format: Label | /url — e.g. Hoodies | /shop?category=Hoodies</div>
    </div>

    <div class="f-field">
      <label>Help Links (one per line: label | url)</label>
      <textarea name="helpLinksRaw" rows="4"><% (sf.helpLinks || []).forEach(function(l) { %><%= l.label %> | <%= l.url %>
<% }) %></textarea>
      <div style="font-family:var(--mono);font-size:0.65rem;color:var(--ink3);margin-top:4px">Format: Label | /url — e.g. Size Guide | /size-guide</div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">SAVE SETTINGS →</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
