<%- include('partials/header') %>

<div class="page-top">
  <div>
    <span class="kicker">// CATALOG</span>
    <h1><%= product ? 'EDIT PRODUCT' : 'NEW PRODUCT' %></h1>
  </div>
  <a href="/admin/products" class="btn btn-ghost">← BACK</a>
</div>

<div class="form-layout">
  <form method="POST" class="admin-form"
        action="<%= product ? '/admin/products/' + product.id : '/admin/products' %>">
    <div class="f-field">
      <label for="name">Product name *</label>
      <input id="name" name="name" required value="<%= product ? product.name : '' %>" placeholder="AURE Heavyweight Hoodie" />
    </div>

    <div class="f-row">
      <div class="f-field">
        <label for="price">Price (INR) *</label>
        <input id="price" name="price" required type="number" min="0" step="1" value="<%= product ? product.price : '' %>" placeholder="1999" />
      </div>
      <div class="f-field">
        <label for="line">Brand line *</label>
        <select id="line" name="line">
          <option value="streetwear" <%= !product || product.line !== 'luxury' ? 'selected' : '' %>>STREETWEAR — noise division</option>
          <option value="luxury" <%= product && product.line === 'luxury' ? 'selected' : '' %>>LUXURY — maison / atelier</option>
        </select>
      </div>
      <div class="f-field">
        <label for="category">Category</label>
        <select id="category" name="category">
          <% ['Tees', 'Hoodies', 'Jackets', 'Shirts', 'Knitwear', 'Kimonos', 'Accessories', 'Caps', 'Bottoms'].forEach((c) => { %>
            <option value="<%= c %>" <%= product && product.category === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="f-row">
      <div class="f-field">
        <label for="stock">Stock count</label>
        <input id="stock" name="stock" type="number" min="0" value="<%= product ? product.stock : 10 %>" />
      </div>
      <div class="f-field">
        <label for="tag">Tag / badge (optional)</label>
        <input id="tag" name="tag" value="<%= product ? product.tag : '' %>" placeholder="NEW / LIMITED" />
      </div>
    </div>

    <div class="f-field">
      <label>Sizes</label>
      <div class="size-checks">
        <% ['XS', 'S', 'M', 'L', 'XL', 'XXL', 'One Size'].forEach((s) => { %>
          <label class="chk-chip">
            <input type="checkbox" name="sizes" value="<%= s %>" <%= product && product.sizes.includes(s) ? 'checked' : '' %> />
            <span><%= s %></span>
          </label>
        <% }) %>
      </div>
    </div>

    <div class="f-field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4" placeholder="Heavyweight 380gsm cotton. Oversized fit. Made in India."><%= product ? product.description : '' %></textarea>
    </div>

    <div class="f-field">
      <label>
        <input type="checkbox" name="featured" <%= product && product.featured ? 'checked' : '' %> />
        <span class="inline-lbl">Feature on homepage</span>
      </label>
    </div>

    <div class="f-field">
      <label>Product Image / Video</label>
      <input type="hidden" id="mediaUrl" name="mediaUrl" value="<%= product ? product.image : '' %>" />

      <div id="media-preview" style="margin-bottom:12px">
        <% if (product && product.image) { %>
          <% if (/\.(mp4|webm|ogg)$/i.test(product.image)) { %>
            <video src="<%= product.image %>" controls style="max-width:300px;border-radius:10px;border:1px solid var(--line)"></video>
          <% } else { %>
            <img src="<%= product.image %>" style="max-width:300px;border-radius:10px;border:1px solid var(--line)" />
          <% } %>
        <% } %>
      </div>

      <label for="fileUpload" class="btn btn-primary" style="cursor:pointer;display:inline-block;margin-bottom:8px">UPLOAD IMAGE / VIDEO</label>
      <input type="file" id="fileUpload" accept="image/*,video/mp4,video/webm" style="display:none" />

      <div id="uploadStatus" style="font-family:var(--mono);font-size:12px;color:var(--muted);margin-top:6px;display:none"></div>
    </div>

    <div class="f-field">
      <label for="imageUrl">Or paste an image URL</label>
      <input id="imageUrl" name="imageUrl" value="" placeholder="https://example.com/photo.jpg" />
      <div style="margin-top:8px">
        <button type="button" id="useUrlBtn" class="btn btn-ghost" style="font-size:12px">USE THIS URL →</button>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-lg">SAVE PRODUCT →</button>
      <a href="/admin/products" class="btn btn-ghost">CANCEL</a>
    </div>
  </form>
</div>

<script>
  var fileInput = document.getElementById('fileUpload');
  var mediaUrl = document.getElementById('mediaUrl');
  var preview = document.getElementById('media-preview');
  var status = document.getElementById('uploadStatus');

  fileInput.addEventListener('change', function() {
    if (!fileInput.files || !fileInput.files[0]) return;
    var fd = new FormData();
    fd.append('file', fileInput.files[0]);
    status.style.display = 'block';
    status.style.color = 'var(--muted)';
    status.textContent = 'Uploading to Cloudinary...';
    fetch('/admin/upload', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.error) { status.style.color = 'red'; status.textContent = 'Error: ' + d.error; return; }
        mediaUrl.value = d.url;
        var isVideo = /\.(mp4|webm|ogg)$/i.test(d.url);
        if (isVideo) {
          preview.innerHTML = '<video src="' + d.url + '" controls style="max-width:300px;border-radius:10px;border:1px solid var(--line)"></video>';
        } else {
          preview.innerHTML = '<img src="' + d.url + '" style="max-width:300px;border-radius:10px;border:1px solid var(--line)" />';
        }
        status.style.color = '#7ee08a';
        status.textContent = 'Uploaded!';
      })
      .catch(function(e) { status.style.color = 'red'; status.textContent = 'Upload failed: ' + e.message; });
  });

  document.getElementById('useUrlBtn').addEventListener('click', function() {
    var url = document.getElementById('imageUrl').value.trim();
    if (!url) return alert('Paste a URL first');
    mediaUrl.value = url;
    var isVideo = /\.(mp4|webm|ogg)$/i.test(url);
    if (isVideo) {
      preview.innerHTML = '<video src="' + url + '" controls style="max-width:300px;border-radius:10px;border:1px solid var(--line)"></video>';
    } else {
      preview.innerHTML = '<img src="' + url + '" style="max-width:300px;border-radius:10px;border:1px solid var(--line)" />';
    }
  });
</script>

<%- include('partials/footer') %>
