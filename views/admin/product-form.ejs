<%- include('partials/header', { active: 'products' }) %>

<div class="page-top">
  <div>
    <span class="kicker">// CATALOG</span>
    <h1><%= product ? 'EDIT PRODUCT' : 'NEW PRODUCT' %></h1>
  </div>
  <a href="/admin/products" class="btn btn-ghost">← BACK</a>
</div>

<div class="form-layout">
  <form method="POST" class="admin-form"
        action="<%= product ? '/admin/products/' + product.id : '/admin/products' %>">
    <div class="f-field">
      <label for="name">Product name *</label>
      <input id="name" name="name" required value="<%= product ? product.name : '' %>" placeholder="AURE Heavyweight Hoodie" />
    </div>

    <div class="f-row">
      <div class="f-field">
        <label for="price">Price (INR) *</label>
        <input id="price" name="price" required type="number" min="0" step="1" value="<%= product ? product.price : '' %>" placeholder="1999" />
      </div>
      <div class="f-field">
        <label for="line">Brand line *</label>
        <select id="line" name="line">
          <option value="streetwear" <%= !product || product.line !== 'luxury' ? 'selected' : '' %>>STREETWEAR</option>
          <option value="luxury" <%= product && product.line === 'luxury' ? 'selected' : '' %>>LUXURY</option>
        </select>
      </div>
    </div>

    <div class="f-row">
      <div class="f-field">
        <label for="category">Category</label>
        <select id="category" name="category">
          <% ['Tees', 'Hoodies', 'Jackets', 'Shirts', 'Knitwear', 'Kimonos', 'Accessories', 'Caps', 'Bottoms'].forEach(function(c) { %>
            <option value="<%= c %>" <%= product && product.category === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>
      <div class="f-field">
        <label for="stock">Stock</label>
        <input id="stock" name="stock" type="number" min="0" value="<%= product ? product.stock : 10 %>" />
      </div>
    </div>

    <div class="f-field">
      <label for="tag">Tag / badge</label>
      <input id="tag" name="tag" value="<%= product ? product.tag : '' %>" placeholder="NEW / LIMITED / SOLD OUT" />
    </div>

    <div class="f-field">
      <label>Sizes</label>
      <div class="size-checks">
        <% ['XS', 'S', 'M', 'L', 'XL', 'XXL', 'One Size'].forEach(function(s) { %>
          <label class="chk-chip">
            <input type="checkbox" name="sizes" value="<%= s %>" <%= product && product.sizes.includes(s) ? 'checked' : '' %> />
            <span><%= s %></span>
          </label>
        <% }) %>
      </div>
    </div>

    <div class="f-field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4" placeholder="Heavyweight 380gsm cotton. Oversized fit."><%= product ? product.description : '' %></textarea>
    </div>

    <div class="f-field">
      <label>
        <input type="checkbox" name="featured" <%= product && product.featured ? 'checked' : '' %> />
        <span class="inline-lbl">Feature on homepage</span>
      </label>
    </div>

    <div class="f-field">
      <label>Product Image / Video</label>
      <input type="hidden" id="mediaUrl" name="mediaUrl" value="<%= product ? product.image : '' %>" />

      <div id="media-preview" style="margin-bottom:12px">
        <% if (product && product.image) { %>
          <% if (/\.(mp4|webm|ogg)$/i.test(product.image)) { %>
            <video src="<%= product.image %>" controls style="max-width:300px;border-radius:8px;border:1px solid var(--line)"></video>
          <% } else { %>
            <img src="<%= product.image %>" style="max-width:300px;border-radius:8px;border:1px solid var(--line)" />
          <% } %>
        <% } %>
      </div>

      <div class="upload-area" id="dropZone">
        <div class="upload-icon">⬆</div>
        <p>Drag & drop a file or click to browse</p>
        <small>JPG, PNG, WEBP, MP4 — MAX 10 MB</small>
        <input type="file" id="fileUpload" accept="image/*,video/mp4,video/webm" style="display:none" />
      </div>
      <div id="uploadStatus" class="upload-status"></div>
    </div>

    <div class="f-field">
      <label for="imageUrl">Or paste an image URL</label>
      <div class="f-row">
        <input id="imageUrl" value="" placeholder="https://example.com/photo.jpg" />
        <button type="button" id="useUrlBtn" class="btn btn-ghost">USE URL →</button>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">SAVE PRODUCT →</button>
      <a href="/admin/products" class="btn btn-ghost">CANCEL</a>
    </div>
  </form>
</div>

<script>
(function() {
  var dropZone = document.getElementById('dropZone');
  var fileInput = document.getElementById('fileUpload');
  var mediaUrl = document.getElementById('mediaUrl');
  var preview = document.getElementById('media-preview');
  var status = document.getElementById('uploadStatus');

  dropZone.addEventListener('click', function() { fileInput.click(); });
  dropZone.addEventListener('dragover', function(e) { e.preventDefault(); dropZone.classList.add('dragover'); });
  dropZone.addEventListener('dragleave', function() { dropZone.classList.remove('dragover'); });
  dropZone.addEventListener('drop', function(e) {
    e.preventDefault(); dropZone.classList.remove('dragover');
    if (e.dataTransfer.files.length) { handleFile(e.dataTransfer.files[0]); }
  });
  fileInput.addEventListener('change', function() {
    if (fileInput.files.length) handleFile(fileInput.files[0]);
  });

  function handleFile(file) {
    var fd = new FormData();
    fd.append('file', file);
    status.className = 'upload-status loading';
    status.textContent = 'Uploading to Cloudinary...';
    fetch('/admin/upload', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.error) { status.className = 'upload-status err'; status.textContent = d.error; return; }
        mediaUrl.value = d.url;
        var isVideo = /\.(mp4|webm|ogg)$/i.test(d.url);
        preview.innerHTML = isVideo
          ? '<video src="' + d.url + '" controls style="max-width:300px;border-radius:8px;border:1px solid var(--line)"></video>'
          : '<img src="' + d.url + '" style="max-width:300px;border-radius:8px;border:1px solid var(--line)" />';
        status.className = 'upload-status ok';
        status.textContent = 'Uploaded!';
      })
      .catch(function(e) { status.className = 'upload-status err'; status.textContent = 'Failed: ' + e.message; });
  }

  document.getElementById('useUrlBtn').addEventListener('click', function() {
    var url = document.getElementById('imageUrl').value.trim();
    if (!url) return alert('Paste a URL first');
    mediaUrl.value = url;
    var isVideo = /\.(mp4|webm|ogg)$/i.test(url);
    preview.innerHTML = isVideo
      ? '<video src="' + url + '" controls style="max-width:300px;border-radius:8px;border:1px solid var(--line)"></video>'
      : '<img src="' + url + '" style="max-width:300px;border-radius:8px;border:1px solid var(--line)" />';
    status.className = 'upload-status ok';
    status.textContent = 'URL set!';
  });
})();
</script>

<%- include('partials/footer') %>
