<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body login-body">
  <div class="login-wrap">
    <div class="login-card">
      <div class="login-logo">AURE<span>.</span><em>ADMIN</em></div>
      <h1>ADMIN ACCESS</h1>
      <p>Enter your password to open the control room.</p>

      <% if (error) { %><div class="alert alert-err"><%= error %></div><% } %>

      <form method="POST" action="/admin/login">
        <div class="f-field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required autofocus placeholder="••••••••" />
        </div>
        <button type="submit" class="btn btn-primary btn-block">UNLOCK <span class="arr">→</span></button>
      </form>
      <a href="/" class="login-back">← Back to store</a>
    </div>
  </div>
</body>
</html>