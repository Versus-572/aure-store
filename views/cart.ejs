<%- include('partials/header') %>

<div class="page-head">
  <div class="page-side" aria-hidden="true">B A G</div>
  <div>
    <span class="kicker">// CART</span>
    <h1>YOUR <em>BAG</em></h1>
  </div>
</div>

<div class="cart-layout" id="cart-page">
  <% if (cart.items.length) { %>
    <div class="cart-items">
      <% cart.items.forEach((it, i) => { %>
        <div class="cart-item">
          <div class="ci-img">
            <% if (it.product.image) { %><img src="<%= it.product.image %>" alt="<%= it.product.name %>" /><% } else { %><div class="ph-box"></div><% } %>
          </div>
          <div class="ci-main">
            <div class="ci-top">
              <div>
                <h3><%= it.product.name %></h3>
                <span class="prod-cat"><%= it.product.category %> • SIZE <%= it.size %></span>
              </div>
              <span class="ci-price">₹<%= it.product.price.toLocaleString('en-IN') %></span>
            </div>
            <div class="ci-bottom">
              <div class="qty-box">
                <button class="ci-update" data-index="<%= i %>" data-op="minus">−</button>
                <span class="ci-qty"><%= it.qty %></span>
                <button class="ci-update" data-index="<%= i %>" data-op="plus">+</button>
              </div>
              <button class="ci-remove" data-index="<%= i %>">REMOVE</button>
              <span class="ci-line">₹<%= it.lineTotal.toLocaleString('en-IN') %></span>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="cart-summary">
      <h3>ORDER SUMMARY</h3>
      <div class="cs-line"><span>Subtotal</span><span>₹<%= cart.subtotal.toLocaleString('en-IN') %></span></div>
      <div class="cs-line"><span>Shipping</span><span><%= cart.shipping === 0 ? 'FREE' : '₹' + cart.shipping.toLocaleString('en-IN') %></span></div>
      <div class="cs-total"><span>TOTAL</span><span>₹<%= cart.total.toLocaleString('en-IN') %></span></div>
      <a href="/checkout" class="btn btn-primary btn-lg btn-block">CHECKOUT →</a>
      <a href="/shop" class="btn btn-ghost btn-block">CONTINUE SHOPPING</a>
    </div>
  <% } else { %>
    <div class="cart-empty">
      <div class="empty-3d" aria-hidden="true"></div>
      <h2>YOUR BAG IS EMPTY</h2>
      <p>Even the noise needs a start.</p>
      <a href="/shop" class="btn btn-primary btn-lg">HIT THE SHOP →</a>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>