<%- include('partials/header') %>

<div class="page-head">
  <div class="page-side" aria-hidden="true">P A Y</div>
  <div>
    <span class="kicker">// CHECKOUT</span>
    <h1>PAY & <em>VIBE</em></h1>
  </div>
</div>

<div class="checkout-layout">
  <form id="checkout-form" class="checkout-form" novalidate>
    <h3>SHIPPING DETAILS</h3>
    <div class="f-row">
      <div class="f-field">
        <label for="name">Full name</label>
        <input id="name" name="name" required autocomplete="name" placeholder="Aryan Shah" />
      </div>
      <div class="f-field">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" required type="tel" placeholder="+91 98XXXXXX00" />
      </div>
    </div>
    <div class="f-field">
      <label for="email">Email</label>
      <input id="email" name="email" required type="email" placeholder="you@email.com" />
    </div>
    <div class="f-field">
      <label for="address">Address</label>
      <textarea id="address" name="address" required placeholder="Flat / street / area"></textarea>
    </div>
    <div class="f-row">
      <div class="f-field">
        <label for="city">City</label>
        <input id="city" name="city" required placeholder="Mumbai" />
      </div>
      <div class="f-field">
        <label for="pincode">PIN code</label>
        <input id="pincode" name="pincode" required placeholder="400001" />
      </div>
    </div>
    <div class="f-field">
      <label for="notes">Order note (optional)</label>
      <input id="notes" name="notes" placeholder="Drop instructions, size preferences..." />
    </div>
    <div class="pay-note">
      <% if (rzpEnabled) { %>
        ⚡ Pure Razorpay checkout — UPI, cards, netbanking in INR.
      <% } else { %>
        ⚠ Demo mode — Razorpay keys not configured. Order will be marked PAID locally. Add keys in <code>.env</code> to accept real payments.
      <% } %>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block" id="pay-btn">PLACE ORDER & PAY ₹<%= cart.total.toLocaleString('en-IN') %> →</button>
    <div class="pay-error" id="pay-error"></div>
  </form>

  <aside class="checkout-summary">
    <h3>YOUR ORDER</h3>
    <% cart.items.forEach((it) => { %>
      <div class="cs-prod">
        <span class="cs-prod-name"><%= it.product.name %> <small>×<%= it.qty %></small></span>
        <span>₹<%= it.lineTotal.toLocaleString('en-IN') %></span>
      </div>
    <% }) %>
    <div class="cs-line"><span>Subtotal</span><span>₹<%= cart.subtotal.toLocaleString('en-IN') %></span></div>
    <div class="cs-line"><span>Shipping</span><span><%= cart.shipping === 0 ? 'FREE' : '₹' + cart.shipping.toLocaleString('en-IN') %></span></div>
    <div class="cs-total"><span>TOTAL</span><span class="inr">₹<%= cart.total.toLocaleString('en-IN') %></span></div>
  </aside>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const RZP_KEY = <%= JSON.stringify(rzpKeyId) %>;
</script>
<%- include('partials/footer') %>