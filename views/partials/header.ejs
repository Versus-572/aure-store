<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%9E%96%3C/text%3E%3C/svg%3E" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body data-page="<%= path %>">
  <div class="noise"></div>
  <div class="ambient" aria-hidden="true"><i class="orb orb-1"></i><i class="orb orb-2"></i></div>

  <header class="nav">
    <a href="/" class="nav-logo">AURE<span class="dot">.</span></a>
    <nav class="nav-links">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a>
      <a href="/shop?line=streetwear" class="sw-link <%= path.startsWith('/shop') && line === 'streetwear' ? 'active' : '' %>">Streetwear</a>
      <a href="/shop?line=luxury" class="lx-link <%= path.startsWith('/shop') && line === 'luxury' ? 'active' : '' %>">Luxury</a>
      <a href="/shop" class="<%= path.startsWith('/shop') && !line ? 'active' : '' %>">Shop</a>
      <a href="#/drops" class="nav-drop-link">Drops</a>
    </nav>
    <div class="nav-actions">
      <a href="/cart" class="cart-btn" aria-label="Cart">
        <span class="cart-ico">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </span>
        <span class="cart-count" id="cart-count"><%= cartCount || 0 %></span>
      </a>
    </div>
  </header>

  <main>